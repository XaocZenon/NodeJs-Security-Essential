<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>Nexus Bank | Future of Digital Banking</title>
  <link rel="stylesheet" href="/styles/landing.css">

</head>
<body>
  <div class="container">
    <!-- navigation -->
    <nav class="navbar">
      <div class="logo">NEXUS<span>BANK</span></div>
      <div class="nav-links">
        <a href="#">Personal</a>
        <a href="#">Business</a>
        <a href="#">Wealth</a>
        <a href="#">Support</a>
        <a href="/login">Log in</a>
        <a href="/register">Open account</a>
      </div>
    </nav>

    <!-- hero -->
    <div class="hero">
      <div class="hero-content">
        <div class="hero-badge">✨ Next-gen digital banking</div>
        <h1>Banking that moves as fast as you do</h1>
        <p>Zero hidden fees, instant transfers, high-yield savings, and 24/7 AI support — all in one powerful account.</p>
        <div style="display: flex; gap: 16px; flex-wrap: wrap;">
          <button class="btn-primary" id="heroCta">Get started →</button>
          <button class="btn-secondary" id="learnMoreBtn">Learn more</button>
        </div>
        <div class="hero-stats">
          <div class="stat-item"><h3>500k+</h3><p>Active customers</p></div>
          <div class="stat-item"><h3>4.9⭐</h3><p>Trustpilot rating</p></div>
          <div class="stat-item"><h3>$0</h3><p>Monthly fees</p></div>
        </div>
      </div>
      <div class="hero-image">
        <!-- modern abstract banking illustration (inline SVG) -->
        <svg width="340" height="280" viewBox="0 0 400 320" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="40" y="100" width="320" height="160" rx="28" fill="white" stroke="#B9D0F0" stroke-width="1.5" />
          <rect x="70" y="140" width="260" height="45" rx="12" fill="#EAF3FF" />
          <circle cx="90" cy="162" r="10" fill="#1E4A8A" />
          <rect x="110" y="154" width="160" height="16" rx="8" fill="#B3CAF0" />
          <rect x="280" y="154" width="40" height="16" rx="6" fill="#1E4A8A" />
          <rect x="70" y="200" width="260" height="45" rx="12" fill="#EAF3FF" />
          <circle cx="90" cy="222" r="10" fill="#1E4A8A" />
          <rect x="110" y="214" width="120" height="16" rx="8" fill="#B3CAF0" />
          <path d="M160 260 L240 260 L200 290 L160 260Z" fill="#1E4A8A" fill-opacity="0.7" />
          <circle cx="200" cy="180" r="6" fill="#0F5CBF" />
          <path d="M290 60 L340 90 L290 120 L240 90 L290 60Z" fill="#1E4A8A" fill-opacity="0.2" stroke="#1E4A8A" stroke-width="1.2"/>
          <text x="290" y="96" font-size="10" fill="#1E4A8A" font-weight="bold">$</text>
        </svg>
      </div>
    </div>

    <!-- features -->
    <div>
      <h2 class="section-title">Banking, reimagined</h2>
      <div class="section-sub">Powerful tools designed to help you grow and manage money seamlessly</div>
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">⚡</div>
          <h3>Instant transfers</h3>
          <p>Send and receive money in real-time, 24/7, to any bank or contact.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">📊</div>
          <h3>Smart insights</h3>
          <p>AI-driven budgeting & spending analytics that help you save smarter.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🔒</div>
          <h3>Bank-grade security</h3>
          <p>Biometric login, encryption, fraud monitoring — your money is safe.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">💳</div>
          <h3>Premium rewards</h3>
          <p>Up to 5% cashback on everyday purchases + exclusive travel perks.</p>
        </div>
      </div>
    </div>

    <!-- security banner / trust -->
    <div class="security-banner">
      <div>
        <h2>🔐 256-bit secure vault</h2>
        <p>FDIC insured up to $250k · 3D Secure · Zero liability policy</p>
      </div>
      <button class="btn-secondary" style="background:white; color:#0f2b5c; border:none;" id="securityBtn">Learn about security →</button>
    </div>

    <!-- Testimonials -->
    <h2 class="section-title">Trusted by over 500k customers</h2>
    <div class="testimonial-grid">
      <div class="testimonial-card">
        <span>★★★★★</span>
        <p>"Switching to Nexus Bank was the best financial decision. Their app is smooth and savings rate unbeatable."</p>
        <div class="user">
          <div class="avatar">JD</div>
          <div><strong>Jessica Davis</strong><br>Freelance designer</div>
        </div>
      </div>
      <div class="testimonial-card">
        <span>★★★★★</span>
        <p>"International transfers are instant and fee-free. Love the modern interface and responsive support."</p>
        <div class="user">
          <div class="avatar">MC</div>
          <div><strong>Michael Chen</strong><br>Entrepreneur</div>
        </div>
      </div>
      <div class="testimonial-card">
        <span>★★★★½</span>
        <p>"Budgeting tools helped me save $6k this year. The virtual cards are a game changer for subscriptions."</p>
        <div class="user">
          <div class="avatar">SR</div>
          <div><strong>Sophia Rodriguez</strong><br>Marketing lead</div>
        </div>
      </div>
    </div>

    <!-- CTA callout -->
    <div class="cta-section">
      <h2>Ready to take control of your finances?</h2>
      <p style="font-size: 1.1rem;">Join Nexus Bank today and get a $50 bonus after your first deposit*</p>
      <div class="cta-buttons">
        <button class="btn-primary" id="ctaOpenAccount">Open an account — it's free</button>
        <button class="btn-secondary" id="contactSalesBtn">Contact sales</button>
      </div>
      <p style="font-size: 0.75rem; margin-top: 24px;">*Terms apply. Bonus credited within 14 days.</p>
    </div>

    <!-- footer -->
    <footer>
      <div class="footer-col">
        <div class="logo" style="font-size: 24px;">NEXUS<span>BANK</span></div>
        <p>Empowering your financial journey<br>since 2022</p>
      </div>
      <div class="footer-links">
        <div>
          <a href="#">About us</a>
          <a href="#">Careers</a>
          <a href="#">Press</a>
        </div>
        <div>
          <a href="#">Help center</a>
          <a href="#">Privacy & terms</a>
          <a href="#">Cookie preferences</a>
        </div>
        <div>
          <a href="#">Download app</a>
          <a href="#">Security</a>
          <a href="#">Developer APIs</a>
        </div>
      </div>
    </footer>
    <div class="copyright">
      © 2026 Nexus Bank. All rights reserved. Banking services provided by Nexus Financial.
    </div>
  </div>
</body>
</html>