<%- include('partials/header', { title: title, query: '' }) %>

<div class="container">
    <div class="error-page" style="
        text-align: center;
        padding: 4rem 2rem;
        background: white;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    ">
        <h1 style="font-size: 3rem; color: #e74c3c; margin-bottom: 1rem;">
            😕
        </h1>
        <h2 style="color: #2c3e50; margin-bottom: 1rem;"><%= title %></h2>
        <p style="color: #7f8c8d; font-size: 1.2rem; margin-bottom: 2rem;">
            <%= message %>
        </p>
        <a href="/" style="
            display: inline-block;
            padding: 0.8rem 2rem;
            background-color: #3498db;
            color: white;
            text-decoration: none;
            border-radius: 4px;
            transition: background-color 0.3s;
        ">Return to Home</a>
    </div>
</div>

<%- include('partials/footer') %>